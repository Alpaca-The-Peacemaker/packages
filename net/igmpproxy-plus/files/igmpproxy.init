#!/bin/sh /etc/rc.common
# igmpproxy-plus - drop-in replacement for the stock igmpproxy service.
# Reads /etc/config/igmpproxy (stock options keep working) and adds
# fast leave, querier timer and upstream IGMP version control.

START=99
USE_PROCD=1

PROG=/usr/sbin/igmpproxy
CONFIGFILE=/var/etc/igmpproxy.conf
SOCKET=/var/run/igmpproxy.sock

# --- helpers ---------------------------------------------------------------

# emit "key value" when the option is set
emit_opt() {
	local section="$1" option="$2" key="$3" suffix="$4" value
	config_get value "$section" "$option"
	[ -n "$value" ] && echo "$key $value$suffix" >> "$CONFIGFILE"
}

emit_list() {
	local section="$1" option="$2" key="$3" values v
	config_get values "$section" "$option"
	for v in $values; do
		echo "	$key $v" >> "$CONFIGFILE"
	done
}

# --- global section --------------------------------------------------------

igmp_header() {
	local s="$1" quickleave fastleave verbose
	config_get_bool quickleave "$s" quickleave 0
	config_get fastleave "$s" fastleave
	config_get verbose "$s" verbose 1
	config_get upstream_igmp_version "$s" upstream_igmp_version
	config_get_bool proxy_ssdp "$s" proxy_ssdp 0

	case "$verbose" in
		2) logopts="-v" ;;
		3) logopts="-v -v" ;;
		*) logopts="" ;;
	esac

	mkdir -p /var/etc
	{
		echo "# generated by /etc/init.d/igmpproxy - edit /etc/config/igmpproxy"
		echo "controlsocket $SOCKET"
	} > "$CONFIGFILE"

	# legacy quickleave maps to tracked fast leave unless fastleave is set
	[ -z "$fastleave" ] && [ "$quickleave" -gt 0 ] && fastleave=auto
	[ -n "$fastleave" ] && echo "fastleave $fastleave" >> "$CONFIGFILE"

	emit_opt "$s" robustness robustness
	emit_opt "$s" query_interval queryinterval s
	emit_opt "$s" query_response_interval queryresponseinterval s
	emit_opt "$s" startup_query_interval startupqueryinterval s
	emit_opt "$s" startup_query_count startupquerycount
	emit_opt "$s" last_member_interval lastmemberinterval ms
	emit_opt "$s" last_member_count lastmembercount
	emit_opt "$s" upstream_leave_delay upstreamleavedelay ms
	emit_opt "$s" host_limit hostlimit
	emit_opt "$s" query_version queryversion
}

# --- interfaces ------------------------------------------------------------

igmp_add_phyint() {
	local s="$1" network direction device up status enabled

	config_get_bool enabled "$s" enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get network "$s" network
	config_get direction "$s" direction

	status="$(ubus -S call "network.interface.$network" status 2>/dev/null)"
	[ -n "$status" ] || return 0
	json_load "$status"
	json_get_var device l3_device
	json_get_var up up
	[ -n "$device" ] && [ "$up" = "1" ] || {
		procd_append_param error "$network is not up"
		return 0
	}

	append netdevs "$device"

	if [ "$direction" = "upstream" ]; then
		has_upstream=1
		append updevs "$device"
	fi

	echo "" >> "$CONFIGFILE"
	echo "phyint $device $direction" >> "$CONFIGFILE"
	emit_opt "$s" ratelimit "	ratelimit"
	emit_opt "$s" threshold "	threshold"

	if [ "$direction" = "downstream" ]; then
		emit_opt "$s" fastleave "	fastleave"
		emit_opt "$s" robustness "	robustness"
		emit_opt "$s" last_member_interval "	lastmemberinterval" ms
		emit_opt "$s" last_member_count "	lastmembercount"
		emit_opt "$s" group_timeout "	grouptimeout" s
		emit_opt "$s" query_version "	queryversion"
	fi

	emit_list "$s" altnet altnet
	emit_list "$s" whitelist whitelist
	emit_list "$s" blacklist blacklist

	# SSDP (UPnP discovery) is local to each LAN; never join it upstream
	# unless asked to. The firewall already drops it coming back in.
	if [ "$direction" = "downstream" ] && [ "$proxy_ssdp" != 1 ]; then
		echo "	blacklist 239.255.255.250/32" >> "$CONFIGFILE"
	fi
}

# Force the IGMP version the kernel uses for upstream joins/leaves.
# 2 = IGMPv2 (leave sent immediately as a v2 Leave), 3 = IGMPv3, auto = 0.
igmp_set_upstream_version() {
	local v dev
	case "$upstream_igmp_version" in
		2|3) v="$upstream_igmp_version" ;;
		*) v=0 ;;
	esac
	for dev in $updevs; do
		[ -w "/proc/sys/net/ipv4/conf/$dev/force_igmp_version" ] &&
			echo "$v" > "/proc/sys/net/ipv4/conf/$dev/force_igmp_version"
	done
}

igmp_add_network() {
	local network
	config_get network "$1" network
	procd_add_interface_trigger "interface.*" "$network" /etc/init.d/igmpproxy reload
}

igmp_add_firewall_routing() {
	local direction zone
	config_get direction "$1" direction
	config_get zone "$1" zone

	if [ "$direction" != "downstream" ] || [ -z "$zone" ]; then
		return 0
	fi

	# First drop SSDP packets then accept all other multicast
	json_add_object ""
	json_add_string type rule
	json_add_string src "$upstream"
	json_add_string dest "$zone"
	json_add_string family ipv4
	json_add_string proto udp
	json_add_string dest_ip "239.255.255.250"
	json_add_string target DROP
	json_close_object

	json_add_object ""
	json_add_string type rule
	json_add_string src "$upstream"
	json_add_string dest "$zone"
	json_add_string family ipv4
	json_add_string proto udp
	json_add_string dest_ip "224.0.0.0/4"
	json_add_string target ACCEPT
	json_close_object
}

igmp_add_firewall_network() {
	local direction zone
	config_get direction "$1" direction
	config_get zone "$1" zone
	[ -n "$zone" ] || return 0

	json_add_object ""
	json_add_string type rule
	json_add_string src "$zone"
	json_add_string family ipv4
	json_add_string proto igmp
	json_add_string target ACCEPT
	json_close_object

	[ "$direction" = "upstream" ] && {
		upstream="$zone"
		config_foreach igmp_add_firewall_routing phyint
	}
}

# --- procd -----------------------------------------------------------------

service_triggers() {
	procd_add_reload_trigger "igmpproxy"
	config_load igmpproxy
	config_foreach igmp_add_network phyint
}

start_service() {
	has_upstream=
	netdevs=
	updevs=
	logopts=
	upstream_igmp_version=
	proxy_ssdp=0

	. /usr/share/libubox/jshn.sh

	config_load igmpproxy
	config_foreach igmp_header igmpproxy
	config_foreach igmp_add_phyint phyint
	[ -n "$has_upstream" ] || return 0

	if ! $PROG -t "$CONFIGFILE" >/dev/null 2>/tmp/igmpproxy.check; then
		logger -t igmpproxy "configuration rejected: $(cat /tmp/igmpproxy.check)"
		return 1
	fi
	rm -f /tmp/igmpproxy.check

	igmp_set_upstream_version

	procd_open_instance
	procd_set_param command $PROG -n
	[ -n "$logopts" ] && procd_append_param command $logopts
	procd_append_param command "$CONFIGFILE"
	procd_set_param netdev $netdevs
	procd_set_param respawn
	procd_set_param stderr 1

	procd_open_data
	json_add_array firewall
	config_foreach igmp_add_firewall_network phyint
	json_close_array
	procd_close_data

	procd_close_instance
}

service_started() {
	procd_set_config_changed firewall
}

service_stopped() {
	procd_set_config_changed firewall
}
