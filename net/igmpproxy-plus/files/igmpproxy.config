config igmpproxy
	# off = RFC behaviour, on = stop forwarding at once, auto = stop at once
	# when the last known host on that interface leaves
	option fastleave 'off'
	# milliseconds between last member queries (stock igmpproxy used 10000)
	option last_member_interval '1000'
	option last_member_count '2'
	# milliseconds to hold the upstream membership after the last leave
	option upstream_leave_delay '0'
	option verbose '1'

config phyint
	option network 'wan'
	option zone 'wan'
	option direction 'upstream'
	list altnet '192.168.1.0/24'

config phyint
	option network 'lan'
	option zone 'lan'
	option direction 'downstream'
